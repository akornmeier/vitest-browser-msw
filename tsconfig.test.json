{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Test environment needs both browser and node types */
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",

    "types": [
      "node",
      "vitest",
      "vitest/globals",
      "vitest/browser",
      "vitest/node",
      "@vitest/browser"
    ],

    "allowJs": true
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.test.ts",
    "vitest.config.ts",
    "src/**/*.ts"
  ]
}
