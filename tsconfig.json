{
  "compilerOptions": {
    /* Base options shared across all configurations */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,

    /* Path resolution */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Module settings */
    "moduleResolution": "node",
    "resolveJsonModule": true,

    /* Default environment - will be overridden */
    "lib": ["ESNext"],
    "target": "ES2020",
    "module": "ESNext"
  },
  "exclude": ["node_modules", "dist"]
}
