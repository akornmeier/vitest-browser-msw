{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Browser-specific settings */
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",

    /* Types for browser environment */
    "types": ["vitest/browser"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.test.ts",
    "tests/setup/browser-setup.ts",
    "!tests/**/*.node.test.ts"
  ]
}
