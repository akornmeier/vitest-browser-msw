{
  "name": "vitest-browser-msw",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser/browser.d.ts",
          "default": "./dist/browser/browser.js"
        }
      },
      "node": {
        "import": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.js"
        },
        "require": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.js"
        },
        "require": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:browser": "vitest --project browser",
    "test:node": "vitest --project node",
    "test:all": "vitest --project browser --project node",
    "test:ci": "vitest run --project browser --project node --reporter=verbose"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.13.9",
    "@vitest/browser": "^3.0.7",
    "@vitest/ui": "latest",
    "happy-dom": "^17.1.9",
    "msw": "^2.7.3",
    "playwright": "^1.50.1",
    "tsup": "^8.0.1",
    "typescript": "^5.8.2",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.5.2"
}
