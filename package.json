{
  "name": "vitest-browser-msw",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/browser/browser.d.ts",
          "default": "./dist/browser/browser.js"
        }
      },
      "node": {
        "import": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.js"
        },
        "require": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.cjs"
        }
      },
      "default": {
        "import": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.js"
        },
        "require": {
          "types": "./dist/node/node.d.ts",
          "default": "./dist/node/node.cjs"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --environment browser",
    "test:node": "vitest run --environment node",
    "test:coverage": "vitest run --coverage",
    "test:adapters": "vitest run tests/adapters",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.13.9",
    "@vitest/browser": "^3.0.7",
    "@vitest/ui": "latest",
    "axe-core": "^4.10.3",
    "happy-dom": "^17.1.9",
    "msw": "^2.7.3",
    "playwright": "^1.50.1",
    "tsup": "^8.0.1",
    "typescript": "^5.8.2",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.5.2"
}
