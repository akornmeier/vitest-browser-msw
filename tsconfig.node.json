{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* Node-specific settings */
    "lib": ["ESNext"],
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Types for Node environment */
    "types": ["node", "vitest/node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.node.test.ts", "vitest.config.ts"]
}
